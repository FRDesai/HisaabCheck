rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(db)/documents/users/$(uid()))
        && get(/databases/$(db)/documents/users/$(uid())).data.role == 'admin';
    }
    function ownsShop(shopId) {
      return signedIn() && get(/databases/$(db)/documents/shops/$(shopId)).data.caUid == uid();
    }

    // Review fields: a fixed status set; approve/reject only in the reviewer's own name and at server time
    // (or with the stored review time left untouched); a reject always carries a note.
    function validBill(d) {
      return d.status in ['draft', 'approved', 'rejected', 'manual_entry']
        && (!(d.status in ['approved', 'rejected'])
            || (d.reviewedBy == uid()
                && (d.reviewedAt == request.time
                    || (resource != null && 'reviewedAt' in resource.data && d.reviewedAt == resource.data.reviewedAt))))
        && (d.status != 'rejected'
            || (d.rejectNote is string && d.rejectNote.size() >= 1 && d.rejectNote.size() <= 500));
    }

    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isAdmin());
      allow create: if signedIn() && uid() == userId && request.resource.data.role == 'ca';
      allow update: if signedIn() && uid() == userId && request.resource.data.role == resource.data.role;
    }

    match /shops/{shopId} {
      allow read, delete: if signedIn() && resource.data.caUid == uid();
      allow create: if signedIn() && request.resource.data.caUid == uid();
      allow update: if signedIn() && resource.data.caUid == uid() && request.resource.data.caUid == uid();

      match /bills/{billId} {
        allow read, delete: if ownsShop(shopId);
        allow create, update: if ownsShop(shopId) && validBill(request.resource.data);
      }
    }

    // Counts and types only; every field type-checked so a bad row cannot break the admin dashboard,
    // server time only so a log cannot be dated into the future, and only for a shop the writer owns.
    function validRouteLog(d) {
      return d.keys().hasOnly(['billId','shopId','caUid','platform','path','reason','piiMasked',
             'piiTypes','latencyMs','estCostUsd','modelName','promptVersion','createdAt'])
        && d.keys().hasAll(['billId','shopId','caUid','platform','path','reason','piiMasked',
             'piiTypes','latencyMs','estCostUsd','modelName','promptVersion','createdAt'])
        && d.caUid == uid()
        && d.createdAt == request.time
        && d.platform == 'web'
        && d.path in ['device', 'cloud']
        && d.reason is string
        && d.piiTypes is list && d.piiTypes.size() <= 8
        && d.piiMasked is int && d.piiMasked >= 0
        && d.latencyMs is number && d.latencyMs >= 0
        && d.estCostUsd is number && d.estCostUsd >= 0 && d.estCostUsd <= 1
        && d.modelName is string
        && d.promptVersion is string
        && d.billId is string
        && d.shopId is string && ownsShop(d.shopId);
    }

    match /routeLogs/{logId} {
      allow create: if signedIn() && validRouteLog(request.resource.data);
      allow read: if signedIn() && (resource.data.caUid == uid() || isAdmin());
      allow update, delete: if false;
    }
  }
}
