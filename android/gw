#!/bin/bash
# Runs ./gradlew with one build at a time across all agents (8 GB machine).
# The lock is the directory android/.gradle/gw.lock (mkdir is the atomic acquire);
# it holds a pid file so a lock left by a dead process is taken over instead of waited on.
# Every pass that fails to acquire sleeps 1 s and counts toward the give-up, except one
# immediate retry right after this script removes a stale lock.
cd "$(dirname "$0")" || exit 1
LOCK="$PWD/.gradle/gw.lock"
GIVE_UP_S=1200
waited=0
nopid=0
retried=0
while :; do
  mkdir -p .gradle 2>/dev/null
  if mkdir "$LOCK" 2>/dev/null; then break; fi
  took=0
  pid=$(cat "$LOCK/pid" 2>/dev/null)
  if [ -n "$pid" ]; then
    nopid=0
    if ! kill -0 "$pid" 2>/dev/null; then
      # Remove only if the pid file still names the dead process (another waiter may have taken over).
      if [ "$(cat "$LOCK/pid" 2>/dev/null)" = "$pid" ]; then
        echo "gw: removing stale lock of dead process $pid" >&2
        rm -f "$LOCK/pid"; rmdir "$LOCK" 2>/dev/null; took=1
      fi
    fi
  elif [ -d "$LOCK" ]; then
    nopid=$((nopid + 1))
    if [ "$nopid" -gt 10 ]; then
      # rmdir only removes an empty directory, so a lock whose owner just wrote its pid survives.
      echo "gw: removing lock with no pid file after about 10s" >&2
      rmdir "$LOCK" 2>/dev/null; nopid=0; took=1
    fi
  else
    nopid=0
  fi
  if [ "$took" -eq 1 ] && [ "$retried" -eq 0 ]; then retried=1; continue; fi
  sleep 1; waited=$((waited + 1))
  if [ "$waited" -ge "$GIVE_UP_S" ]; then
    echo "gw: gave up waiting for $LOCK after ${waited}s (held by pid ${pid:-unknown}; remove it if no build is running)" >&2
    exit 75
  fi
done
echo $$ > "$LOCK/pid"
release() { if [ "$(cat "$LOCK/pid" 2>/dev/null)" = "$$" ]; then rm -f "$LOCK/pid"; rmdir "$LOCK" 2>/dev/null; fi; }
trap release EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
./gradlew --console=plain "$@"
