rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /shops/{shopId}/bills/{file} {
      function shop() { return firestore.get(/databases/(default)/documents/shops/$(shopId)).data; }
      // The shop's CA and its linked owner may read and add new photos; only the CA replaces or deletes.
      function isCaOrOwner() {
        return request.auth != null
          && (shop().caUid == request.auth.uid || shop().get('ownerUid', null) == request.auth.uid);
      }
      function validImage() {
        return shop().storeImages == true
          && request.resource.size < 3 * 1024 * 1024 && request.resource.contentType == 'image/jpeg';
      }
      allow read: if isCaOrOwner();
      allow delete: if request.auth != null && shop().caUid == request.auth.uid;
      // Replacing a stored photo (of a bill that may since have been reviewed) is the CA's.
      // The emulator judges an upload over an existing path as `create` (production may too), so the CA's
      // replacement must pass here as well; the owner only ever adds a path that holds nothing yet.
      allow create: if request.auth != null && validImage()
        && (shop().caUid == request.auth.uid
            || (resource == null && shop().get('ownerUid', null) == request.auth.uid));
      allow update: if request.auth != null && shop().caUid == request.auth.uid && validImage();
    }
  }
}
